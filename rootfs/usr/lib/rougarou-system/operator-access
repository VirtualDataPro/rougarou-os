#!/usr/bin/python3 -I
"""Explicitly manage the install owner's sudo policy; never invoked by upgrades."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile


class AccessError(Exception):
    pass


def local_account(username: str, passwd: Path = Path("/etc/passwd")) -> int:
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
        raise AccessError("Use the exact local operator username (letters, digits, underscore or hyphen).")
    for line in passwd.read_text().splitlines():
        fields = line.split(":")
        if len(fields) == 7 and fields[0] == username:
            uid = int(fields[2])
            if not 1000 <= uid < 60000:
                raise AccessError("Only a regular local operator account may receive this policy.")
            return uid
    raise AccessError("The named operator is not a local account.")


def policy_text(username: str) -> str:
    return ("# Managed by Rougarou operator-access. Change with: rougarou access\n"
            "# Explicit headless mode: this account has full root authority through sudo.\n"
            f"{username} ALL=(ALL:ALL) NOPASSWD: ALL\n")


def visudo(candidate: Path | None = None) -> None:
    command = ["/usr/sbin/visudo", "-c"]
    if candidate is not None:
        command.extend(["-f", str(candidate)])
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.returncode:
        raise AccessError("sudo policy validation failed; existing policy was preserved or restored.")


class Policy:
    """Paths are injectable for isolated tests, never accepted from the CLI."""

    def __init__(self, etc: Path = Path("/etc"), owner_uid: int = 0, validator=visudo):
        self.etc = etc
        self.directory = etc / "rougarou"
        self.state = self.directory / "operator-access.json"
        self.grant = etc / "sudoers.d" / "90-rougarou-owner"
        self.owner_uid = owner_uid
        self.validator = validator

    def check(self, path: Path, directory: bool = False) -> bool:
        try:
            info = path.lstat()
        except FileNotFoundError:
            return False
        expected_type = stat.S_ISDIR if directory else stat.S_ISREG
        if (not expected_type(info.st_mode) or info.st_uid != self.owner_uid
                or info.st_mode & 0o022):
            raise AccessError(f"Refusing unsafe ownership, type or permissions: {path}")
        return True

    def read(self) -> dict | None:
        self.check(self.etc, directory=True)
        if self.check(self.directory, directory=True) and self.check(self.state):
            try:
                data = json.loads(self.state.read_text())
            except (ValueError, UnicodeError):
                raise AccessError("Invalid operator access state; no files were changed.") from None
            if (not isinstance(data, dict) or set(data) != {"schema_version", "username", "uid", "mode"}
                    or data["schema_version"] != 1 or data["mode"] not in {"headless", "password"}
                    or type(data["uid"]) is not int or not isinstance(data["username"], str)
                    or local_account(data["username"], self.etc / "passwd") != data["uid"]):
                raise AccessError("Invalid or stale operator access state; no files were changed.")
            return data
        return None

    def status(self, username: str, verify_policy: bool = True) -> dict:
        uid = local_account(username, self.etc / "passwd")
        state = self.read()
        if verify_policy:
            self.check(self.grant.parent, directory=True)
            exists = self.check(self.grant)
            if exists and (not state or state["mode"] != "headless"
                           or self.grant.read_text() != policy_text(state["username"])):
                raise AccessError("The managed sudoers path contains unrecognized policy; it was preserved.")
            if state and state["mode"] == "headless" and not exists:
                raise AccessError("Headless access state has no matching sudoers grant; administrator review is required.")
        return {"username": username, "uid": uid,
                "mode": state["mode"] if state and state["username"] == username else "unmanaged",
                "owner": state["username"] if state else None}

    def write(self, path: Path, contents: bytes | None, mode: int) -> None:
        if contents is None:
            path.unlink(missing_ok=True)
        else:
            descriptor, temporary = tempfile.mkstemp(prefix=".rougarou-access-", dir=path.parent)
            try:
                with os.fdopen(descriptor, "wb") as stream:
                    os.fchmod(stream.fileno(), mode)
                    stream.write(contents)
                    stream.flush()
                    os.fsync(stream.fileno())
                os.replace(temporary, path)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
        descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

    def set(self, username: str, mode: str, acknowledged: bool = False) -> dict:
        if mode not in {"headless", "password"}:
            raise AccessError("Choose headless or password mode.")
        if mode == "headless" and not acknowledged:
            raise AccessError("Headless mode requires --acknowledge-root-access: this account and its programs can gain full root authority.")
        current = self.status(username)
        if current["owner"] not in {None, username}:
            raise AccessError("Another install owner is already recorded; transfer requires administrator review.")
        if not self.grant.parent.is_dir():
            raise AccessError("sudoers.d is missing; install and configure sudo first.")
        if not self.directory.exists():
            self.directory.mkdir(mode=0o755)
            self.directory.chmod(0o755)
        self.check(self.directory, directory=True)
        lock = self.directory / ".operator-access.lock"
        self.check(lock)
        descriptor = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX)
            # Recheck after taking the lock, including a concurrent owner change.
            current = self.status(username)
            if current["owner"] not in {None, username}:
                raise AccessError("Another install owner is already recorded.")
            self.validator()
            old_grant = self.grant.read_bytes() if self.grant.exists() else None
            old_state = self.state.read_bytes() if self.state.exists() else None
            grant = policy_text(username).encode() if mode == "headless" else None
            if grant is not None:
                candidate_fd, name = tempfile.mkstemp(prefix=".rougarou-check-", dir=self.grant.parent)
                try:
                    with os.fdopen(candidate_fd, "wb") as stream:
                        os.fchmod(stream.fileno(), 0o440)
                        stream.write(grant)
                    self.validator(Path(name))
                finally:
                    os.unlink(name)
            state = {"schema_version": 1, "username": username, "uid": current["uid"], "mode": mode}
            try:
                self.write(self.grant, grant, 0o440)
                self.validator()
                self.write(self.state, (json.dumps(state, indent=2) + "\n").encode(), 0o644)
            except (AccessError, OSError):
                self.write(self.grant, old_grant, 0o440)
                self.write(self.state, old_state, 0o644)
                raise
            return self.status(username)
        finally:
            os.close(descriptor)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    status = commands.add_parser("status")
    status.add_argument("username")
    status.add_argument("--json", action="store_true")
    change = commands.add_parser("set")
    change.add_argument("username")
    change.add_argument("mode", choices=["headless", "password"])
    change.add_argument("--acknowledge-root-access", action="store_true")
    args = parser.parse_args(argv)
    try:
        policy = Policy()
        if args.command == "set":
            if os.geteuid() != 0:
                raise AccessError("Setting access requires administrator authentication through sudo.")
            result = policy.set(args.username, args.mode, args.acknowledge_root_access)
        else:
            # Ordinary operators can read the public mode record but cannot read
            # root's 0440 sudoers files. CLI independently probes effective sudo.
            result = policy.status(args.username, verify_policy=os.geteuid() == 0)
        if getattr(args, "json", False):
            print(json.dumps(result, sort_keys=True))
        else:
            print(f"{result['username']}: {result['mode']} operator access")
            if result["mode"] == "password":
                print("Rougarou's passwordless grant is absent. Separate administrator sudo policies are unchanged.")
        return 0
    except (AccessError, OSError) as error:
        print(f"operator-access: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
